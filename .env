# Settings baked into the app when it is built. Committed on purpose: nothing here is secret.
# Google OAuth client ID for Google Drive backup (see "Google Drive backup" in README.md).
# A client ID is public by design; Google only accepts sign-ins from the authorized origins set in Cloud Console.
# To use a different ID on one machine, put it in .env.local (not committed), which overrides this file.
VITE_GOOGLE_CLIENT_ID=54233214122-cre4patp56jvu80fp5j0dka4t1lmskcu.apps.googleusercontent.com
